{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash(git status)", "Bash(npm test)"]
  },
  "env": {
    "MAX_PARALLEL_SUBAGENTS": "100",
    "ANTHROPIC_API_KEY": "sk-fixture-secret-value",
    "GITHUB_TOKEN": "ghp-fixture-token-value"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "/usr/local/bin/gate-tool-use"}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "/usr/local/bin/on-session-stop"}]
      }
    ]
  },
  "mcpServers": {
    "filesystem": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]},
    "github": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"]}
  }
}
